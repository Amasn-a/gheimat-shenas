# Development defaults (dev/run-backend.sh). NEVER use these values in production: PE_ENV=production refuses fakes.
PE_ENV=development
PE_DB_URL=jdbc:postgresql://127.0.0.1:5432/price_expert
PE_DB_USER=pe
PE_DB_PASSWORD=pe
PE_DB_POOL=20
PE_HTTP_HOST=0.0.0.0
PE_HTTP_PORT=8080
# fake = in-project DigiCoin stand-in (R-44). Do not point this at the real or test DigiCoin service.
PE_COIN_PROVIDER=fake
PE_COIN_TIMEOUT_MS=2000
PE_FAKE_START_BALANCE=120
# production: PE_CODE_KEY=<base64 32-byte AES key from the secret store>
PE_CATALOG_JSON=./data/qeymatshenas_products.json
PE_MEDIA_DIR=./data/images
PE_MEDIA_PREFIX=/media/
PE_PLAYER_DIR=./player
PE_ADMIN_DIR=./admin
PE_DEV_ADMINS=editor:EDITOR:editor-dev-password,viewer:VIEWER:viewer-dev-password
# pending owner values (structural invariants only until set):
# PE_BOUND_MAX_PLAYS_PER_DAY=
# PE_BOUND_MAX_CHECKPOINT_REWARD=
# PE_BOUND_MAX_CONTINUE_COST=
# PE_BOUND_MAX_CONTINUE_CAP=
# PE_BOUND_MAX_STREAK_REWARD=
